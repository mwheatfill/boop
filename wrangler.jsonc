{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boop-dev",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server-entry.ts",
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  // vars are non-inheritable; repeat per env block.
  "vars": {
    "PUBLIC_APP_NAME": "boop-dev",
    "PUBLIC_ENV": "dev",
    "PUBLIC_APP_ORIGIN": "http://localhost:5173",
    "DEV_USER_EMAIL": "michael.wheatfill@switchthink.com"
  },
  // Secrets, per cloudflare-docs (Workers Configuration > Secrets), are
  // declared here for type generation + deploy-time validation; their
  // values are set with `wrangler secret put` (prod) or `.dev.vars` (local).
  "secrets": {
    "required": ["BOOP_SECRETS_KEK"]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boop-dev",
      "database_id": "45d84867-7a4d-4119-9108-f80278c459c3",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BODIES",
      "bucket_name": "boop-bodies-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DISPATCH_QUEUE",
        "queue": "boop-dispatch-dev"
      },
      {
        "binding": "ALERT_QUEUE",
        "queue": "boop-alerts-dev"
      }
    ],
    "consumers": [
      {
        "queue": "boop-dispatch-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "boop-dispatch-dlq-dev"
      },
      {
        "queue": "boop-alerts-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "boop-alerts-dlq-dev"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOB_ALARM",
        "class_name": "JobAlarm"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "WEBHOOK_RATE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JobAlarm"]
    }
  ],
  "env": {
    "production": {
      "name": "boop-prod",
      "vars": {
        "PUBLIC_APP_NAME": "boop-prod",
        "PUBLIC_ENV": "production",
        "PUBLIC_APP_ORIGIN": "https://boop.example.com"
      },
      "secrets": {
        "required": ["BOOP_SECRETS_KEK"]
      },
      "triggers": {
        "crons": ["* * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "boop-prod",
          "database_id": "2b612221-7684-4af3-be8d-6f8ef098079d",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BODIES",
          "bucket_name": "boop-bodies-prod"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "DISPATCH_QUEUE",
            "queue": "boop-dispatch-prod"
          },
          {
            "binding": "ALERT_QUEUE",
            "queue": "boop-alerts-prod"
          }
        ],
        "consumers": [
          {
            "queue": "boop-dispatch-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "boop-dispatch-dlq-prod"
          },
          {
            "queue": "boop-alerts-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "boop-alerts-dlq-prod"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "JOB_ALARM",
            "class_name": "JobAlarm"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "WEBHOOK_RATE_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["JobAlarm"]
        }
      ]
    }
  }
}
