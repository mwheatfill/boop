{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boop-dev",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server-entry.ts",
  "workers_dev": false,
  "routes": [{ "pattern": "boop-dev.stlabs.org", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  // vars are non-inheritable; repeat per env block.
  "vars": {
    "PUBLIC_APP_NAME": "boop-dev",
    "PUBLIC_ENV": "dev",
    "PUBLIC_APP_ORIGIN": "https://boop-dev.stlabs.org",
    "TEAM_DOMAIN": "https://switchthink.cloudflareaccess.com",
    "POLICY_AUD": "b286056314c5c0c603f964cc366580c76f32b99cae6f94523a243af4b02e897f",
    "CF_PROVIDER_ACCOUNT_ID": "1412add43dbe3b640984af5105b3a52a",
    "CF_PROVIDER_ZONE_ID": "",
    "CF_TUNNEL_HOSTNAME_BASE": "tunnels.stlabs.org"
  },
  // BOOP_SECRETS_KEK lives in the account Secrets Store (read via env.BOOP_SECRETS_KEK.get()).
  // TEAM_DOMAIN + POLICY_AUD are non-secret Access config and live in vars per env.
  "secrets_store_secrets": [
    {
      "binding": "BOOP_SECRETS_KEK",
      "store_id": "806c567ab8fb4847a628e8c39380e1f5",
      "secret_name": "boop-secrets-kek-dev"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boop-dev",
      "database_id": "7677bae9-8b87-454f-8101-2f27cfa011a7",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BODIES",
      "bucket_name": "boop-bodies-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DISPATCH_QUEUE",
        "queue": "boop-dispatch-dev"
      },
      {
        "binding": "ALERT_QUEUE",
        "queue": "boop-alerts-dev"
      }
    ],
    "consumers": [
      {
        "queue": "boop-dispatch-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "boop-dispatch-dlq-dev"
      },
      {
        "queue": "boop-alerts-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "boop-alerts-dlq-dev"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOB_ALARM",
        "class_name": "JobAlarm"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "WEBHOOK_RATE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JobAlarm"]
    }
  ],
  "env": {
    "production": {
      "name": "boop-prod",
      "workers_dev": false,
      "routes": [{ "pattern": "boop.stlabs.org", "custom_domain": true }],
      "vars": {
        "PUBLIC_APP_NAME": "boop-prod",
        "PUBLIC_ENV": "production",
        "PUBLIC_APP_ORIGIN": "https://boop.stlabs.org",
        "TEAM_DOMAIN": "https://switchthink.cloudflareaccess.com",
        "POLICY_AUD": "14365b36cd81148634254fa8571cbb4b5d47195289b5a97197e717da6e8114ca",
        "CF_PROVIDER_ACCOUNT_ID": "1412add43dbe3b640984af5105b3a52a",
        "CF_PROVIDER_ZONE_ID": "",
        "CF_TUNNEL_HOSTNAME_BASE": "tunnels.stlabs.org"
      },
      "secrets_store_secrets": [
        {
          "binding": "BOOP_SECRETS_KEK",
          "store_id": "806c567ab8fb4847a628e8c39380e1f5",
          "secret_name": "boop-secrets-kek-prod"
        }
      ],
      "triggers": {
        "crons": ["* * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "boop-prod",
          "database_id": "7b1222e4-1a06-49d4-970b-71a0540f5489",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BODIES",
          "bucket_name": "boop-bodies-prod"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "DISPATCH_QUEUE",
            "queue": "boop-dispatch-prod"
          },
          {
            "binding": "ALERT_QUEUE",
            "queue": "boop-alerts-prod"
          }
        ],
        "consumers": [
          {
            "queue": "boop-dispatch-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "boop-dispatch-dlq-prod"
          },
          {
            "queue": "boop-alerts-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "boop-alerts-dlq-prod"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "JOB_ALARM",
            "class_name": "JobAlarm"
          }
        ]
      },
      "ratelimits": [
        {
          "name": "WEBHOOK_RATE_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["JobAlarm"]
        }
      ]
    }
  }
}
