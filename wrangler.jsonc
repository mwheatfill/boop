{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Single-file multi-env: top level is dev defaults; CLOUDFLARE_ENV=production
  // selects the env.production block at build time. README → "Per-environment
  // wrangler config" covers gotchas (non-inheritable bindings, explicit
  // env.production.name to avoid the awkward `-dev-production` auto-suffix).
  "name": "template-cf-fullstack-dev",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_APP_NAME": "template-cf-fullstack-dev",
    "PUBLIC_ENV": "dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "template-cf-fullstack-dev",
      "database_id": "18db1684-4240-4fa5-a185-d54d58fac67b",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "production": {
      "name": "template-cf-fullstack-prod",
      "vars": {
        "PUBLIC_APP_NAME": "template-cf-fullstack-prod",
        "PUBLIC_ENV": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "template-cf-fullstack-prod",
          "database_id": "8e91e4d7-25a1-43a7-aa2a-68dc36d4b21c",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
