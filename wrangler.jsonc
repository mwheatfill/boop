{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boop-dev",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  // vars are non-inheritable; repeat per env block.
  "vars": {
    "PUBLIC_APP_NAME": "boop-dev",
    "PUBLIC_ENV": "dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boop-dev",
      "database_id": "45d84867-7a4d-4119-9108-f80278c459c3",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "production": {
      "name": "boop-prod",
      "vars": {
        "PUBLIC_APP_NAME": "boop-prod",
        "PUBLIC_ENV": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "boop-prod",
          "database_id": "2b612221-7684-4af3-be8d-6f8ef098079d",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
