{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Default config used by `pnpm dev`, `pnpm bootstrap`, and CI deploy-dev.
  // Production deploys use wrangler.production.jsonc instead, selected via
  // the Vite plugin's configPath option (set WRANGLER_CONFIG=wrangler.production.jsonc
  // before `pnpm build`).
  //
  // The TanStack Start Vite plugin flattens wrangler config into
  // dist/server/wrangler.json and drops nested `env:` blocks; that's why
  // we ship per-env files instead of a single multi-env config.
  "name": "template-cf-fullstack-dev",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_APP_NAME": "template-cf-fullstack-dev",
    "PUBLIC_ENV": "dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "template-cf-fullstack-dev",
      "database_id": "18db1684-4240-4fa5-a185-d54d58fac67b",
      "migrations_dir": "drizzle"
    }
  ]
}
