# Local development environment variables.
# Copy this file to `.dev.vars` and fill in values for the recipes you
# install. `.dev.vars` is gitignored. For deployed environments set these
# via `wrangler secret put` or GitHub Secrets.
#
# The template ships with no required runtime env vars. Each recipe you
# install will add its own block here documenting what it needs.

# --- Public (safe to expose to client) ---
PUBLIC_APP_NAME=template-cf-fullstack-local
PUBLIC_ENV=local
