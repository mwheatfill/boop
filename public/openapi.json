          },
          "name": {
            "example": "Alex Doe",
            "type": "string"
          },
          "image": {
            "example": "https://example.com/avatar.png",
            "type": "string",
            "format": "uri"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "operator"
            ],
            "description": "Operator role per ADR-016"
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ],
        "additionalProperties": false,
        "description": "Authenticated user as returned by getCurrentUser(request)."
