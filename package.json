{
  "name": "boop",
  "version": "0.0.2",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy:dev": "vite build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production vite build && wrangler deploy --env production",
    "cf-typegen": "wrangler types",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local && pnpm db:seed:starters",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi-contract.ts",
    "audit:patterns": "tsx scripts/audit-patterns/index.ts",
    "audit:knip": "knip",
    "recipe": "tsx scripts/recipe.ts",
    "seed:demo": "tsx scripts/seed-demo/index.ts",
    "db:seed:starters": "tsx scripts/seed-starter-recipes.ts",
    "seed:remote": "tsx scripts/seed-demo/push-remote.ts",
    "bootstrap": "bash scripts/bootstrap.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "intent:list": "intent list",
    "intent:list:json": "intent list --json",
    "intent:stale": "intent stale",
    "prepare": "husky",
    "postinstall": "wrangler types 2>/dev/null || echo 'wrangler types skipped: run pnpm cf-typegen after wrangler login'"
  },
  "dependencies": {
    "@ai-sdk/azure": "^3.0.71",
    "@base-ui/react": "^1.4.1",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/lang-liquid": "^6.3.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-ssr-query": "^1.166.12",
    "@tanstack/react-start": "^1.167.65",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.9",
    "ai": "^6.0.199",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "codemirror": "^6.0.2",
    "croner": "^9.1.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "liquidjs": "^10.25.7",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.6",
    "recharts": "3.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tinykeys": "3.0.0",
    "zod": "^4.4.3",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vite-plugin": "^1.36.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/intent": "^0.0.41",
    "@tanstack/react-query-devtools": "^5.90.0",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "knip": "6.13.1",
    "lint-staged": "^17.0.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "//": "pnpm allowBuilds lives in pnpm-workspace.yaml per pnpm v11."
}
